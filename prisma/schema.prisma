generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

// ─── Admin accounts (created on first Cognito login, must be in "Admins" group) ─
model Admin {
  id         String   @id @default(uuid())
  cognitoSub String   @unique
  email      String   @unique
  name       String?
  createdAt  DateTime @default(now())

  eventReviews Event[]         @relation("EventReviewedBy")
  auditLogs    AdminAuditLog[]

  @@map("admins")
}

// ─── Admin audit log ─────────────────────────────────────────────────────────
model AdminAuditLog {
  id         String   @id @default(uuid())
  adminId    String
  admin      Admin    @relation(fields: [adminId], references: [id])
  action     String
  targetType String
  targetId   String
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([adminId])
  @@index([targetId])
  @@map("admin_audit_logs")
}

// ─── Organiser accounts ───────────────────────────────────────────────────────
// An Organiser is a standalone brand entity that Users manage. It has no
// credentials of its own — access is granted through OrganiserMember rows.
// `createdBy` records which User created the profile (non-unique, informational).
model Organiser {
  id            String          @id @default(uuid())
  createdBy     String?
  createdByUser User?           @relation("OrganiserCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  email         String          @unique
  verified      Boolean         @default(false)
  status        OrganiserStatus @default(APPROVED)

  // Profile — filled during onboarding, editable afterwards
  orgName       String?
  contactName   String?
  contactEmail  String?
  phone         String?
  abn           String?
  website       String?
  instagram     String?
  facebook      String?
  bio           String?
  logoUrl       String?
  logoPosition  String?  @default("50% 50%")
  coverImageUrl String?
  coverPosition String?  @default("50% 50%")
  photos        String[]

  // Legal & compliance — required for ATO SERR reporting (ToS §3.2, Privacy Policy §2.1)
  legalName         String?
  // Insurance self-declaration only — no documents collected (ToS §5.3, Privacy Policy §4.4)
  insuranceDeclared Boolean @default(false)
  // Date of birth (ISO 8601 yyyy-mm-dd) — used for identity verification and ATO SERR reporting.
  // Not required for organisers who only list external-link events.
  dob               String?

  // Stripe Express Connect — Startline stores only the account reference ID.
  // Bank account details (BSB + account number) are collected and held by Stripe directly (ToS §3.3, Privacy Policy §4.2).
  stripeAccountId          String? @unique
  stripeOnboardingComplete Boolean @default(false)

  events        Event[]
  reviews       Review[]
  announcements Announcement[]
  notifications Notification[]
  registrations Registration[]
  follows       OrganiserFollow[]
  members       OrganiserMember[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@map("organisers")
}

enum OrganiserRole {
  OWNER
  MANAGER
}

// A User's membership on an Organiser, granting a role. Exactly one
// OWNER per organiser (enforced in app logic).
model OrganiserMember {
  id          String        @id @default(uuid())
  organiserId String
  organiser   Organiser     @relation(fields: [organiserId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        OrganiserRole @default(MANAGER)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([organiserId, userId])
  @@index([userId])
  @@map("organiser_members")
}

enum OrganiserStatus {
  APPROVED
  SUSPENDED
}

// ─── Event listings ───────────────────────────────────────────────────────────
model Event {
  id          String      @id @default(uuid())
  organiser   Organiser   @relation(fields: [organiserId], references: [id])
  organiserId String
  status      EventStatus @default(DRAFT)

  // Step 1 — basics
  title       String
  discipline  String
  description String?

  // Step 2 — date & location
  eventDate String
  endDate   String? // optional multi-day end (ISO yyyy-mm-dd)
  startTime String
  endTime   String
  venue     String
  address   String?
  city      String
  state     String
  latitude  Float?
  longitude Float?

  // Step 3 — format & categories
  format     String
  level      String
  categories Json
  cap        Int?
  minAge     Int    @default(16)

  // Step 4 — tickets (pricing tiers — NOT start waves)
  waves             Json
  // DEPRECATED — organiser start waves are moving to the StartWave table
  // (see startWaveRows). Kept during the transition so existing readers keep
  // working; drop once every consumer reads the relation. Was: JSON array of
  // heat definitions (start time, capacity, match conditions).
  startWaves        Json?
  inclusions        String?
  extras            String?
  activations       String?
  refundPolicy      String?
  registrationType  String  @default("startline")
  feeStructure      String  @default("athlete")

  // Payouts — set once an admin triggers a Stripe Connect payout after the event ends.
  payoutTriggered   Boolean   @default(false)
  payoutAmountCents Int?
  payoutAt          DateTime?

  // Step 5 — media & logistics
  coverImageUrl       String?
  photos              String[]
  informationPdfUrl   String?
  registrationUrl     String?
  bagDrop             String?
  parking             String?
  accessibilityInfo   String?
  additionalNotes     String?

  // Admin review
  adminNotes      String?
  rejectionReason String?
  reviewedById    String?
  reviewedBy      Admin?    @relation("EventReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?

  isPinned      Boolean        @default(false)
  reviews       Review[]
  announcements Announcement[]
  registrations Registration[]
  savedEvents   SavedEvent[]
  startWaveRows StartWave[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("events")
}

// ─── Start waves (heats) ──────────────────────────────────────────────────────
// Organiser-defined start groups. Distinct from the ticket tiers in Event.waves:
// a start wave is a physical heat with a start time, an optional capacity, and
// optional match conditions (finish-time band / gender / age band) used to seed
// athletes in by pace. Registrations link here via Registration.startWaveId.
model StartWave {
  id        String  @id @default(uuid())
  eventId   String
  event     Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  label     String
  startTime String? // "HH:mm", falls back to the event start time when null
  capacity  Int?    // null = unlimited

  // Match conditions — an athlete must satisfy every condition that is set.
  finishMin Int?      // whole minutes, inclusive lower bound
  finishMax Int?      // whole minutes, inclusive upper bound
  genders   String[]  // empty = any gender
  ageMin    Int?      // inclusive
  ageMax    Int?      // inclusive

  sortOrder Int @default(0) // preserves the organiser's wave order

  registrations Registration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, label])
  @@index([eventId])
  @@map("start_waves")
}

enum EventStatus {
  DRAFT // saved, not submitted
  PENDING // submitted — awaiting admin review
  APPROVED // live on the platform
  REJECTED // admin denied
  ARCHIVED // organiser archived
}

// ─── Athlete reviews ──────────────────────────────────────────────────────────
model Review {
  id          String    @id @default(uuid())
  organiserId String
  organiser   Organiser @relation(fields: [organiserId], references: [id], onDelete: Cascade)
  eventId     String?
  event       Event?    @relation(fields: [eventId], references: [id], onDelete: SetNull)
  eventTitle  String?
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Ratings 1–5
  overallRating      Int
  atmosphereRating   Int?
  organisationRating Int?
  experienceRating   Int?

  title        String
  body         String
  reviewerName String

  isVerified  Boolean @default(false)
  isPublished Boolean @default(true)

  createdAt DateTime @default(now())

  @@index([organiserId])
  @@index([userId])
  @@map("reviews")
}

// ─── Organiser notifications ──────────────────────────────────────────────────
model Notification {
  id          String           @id @default(uuid())
  organiserId String
  organiser   Organiser        @relation(fields: [organiserId], references: [id], onDelete: Cascade)
  type        NotificationType
  title       String
  body        String
  eventId     String?
  read        Boolean          @default(false)
  createdAt   DateTime         @default(now())

  @@map("notifications")
}

enum NotificationType {
  EVENT_APPROVED
  EVENT_REJECTED
  NEW_REGISTRATION
}

// ─── Organiser announcements (per-event) ─────────────────────────────────────
model Announcement {
  id          String    @id @default(uuid())
  eventId     String
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  organiserId String
  organiser   Organiser @relation(fields: [organiserId], references: [id], onDelete: Cascade)
  title       String
  body        String
  createdAt   DateTime  @default(now())

  @@map("announcements")
}

// ─── Athlete registrations ────────────────────────────────────────────────────
// One row per athlete entry into an event. organiserId is denormalised from the
// event so organisers can query their entire registrant base efficiently.
model Registration {
  id          String    @id @default(uuid())
  eventId     String
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  organiserId String
  organiser   Organiser @relation(fields: [organiserId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?     @relation(fields: [userId], references: [id])

  athleteName           String
  athleteEmail          String
  firstName             String?
  lastName              String?
  dateOfBirth           String? // ISO yyyy-mm-dd
  gender                String?
  mobile                String?
  emergencyContactName  String?
  emergencyContactPhone String?
  medicalNotes          String?
  waiverAccepted        Boolean @default(false)
  category     String?
  // Ticket tier bought at checkout (pricing). Distinct from the start wave below.
  waveLabel    String?
  // Organiser-assigned start wave (heat). This is the "wave" athletes see and are
  // notified about. Seeded by the wave builder's conditions, or set by hand.
  // startWaveId is the source of truth (FK to StartWave); startWaveLabel is a
  // denormalised mirror kept during the JSON→table transition and will be dropped.
  startWaveId    String?
  startWave      StartWave? @relation(fields: [startWaveId], references: [id], onDelete: SetNull)
  startWaveLabel String?
  // The start wave the athlete was last notified about. Lets organisers reshuffle
  // waves silently and only message athletes whose wave changed since last time.
  waveNotifiedLabel String?
  // Athlete's self-reported estimated finish time, in whole minutes. Used to seed
  // athletes into start waves by pace. Null when not provided.
  estimatedFinishMinutes Int?
  bibNumber    String?

  // Money is stored in integer cents (AUD) to avoid float rounding.
  amountCents      Int    @default(0) // ticket price paid by the athlete
  platformFeeCents Int    @default(0) // Startline fee (3% + $1) on this entry
  feeStructure     String @default("athlete") // "athlete" | "organiser"

  status                RegistrationStatus @default(CONFIRMED)
  stripePaymentIntentId String?

  // Race results — organiser-entered (race management) + legacy profile fields
  resultDistance  String?
  resultTime      String?
  resultPlacement String?
  isPersonalBest  Boolean @default(false)
  isTopResult     Boolean @default(false)
  finishTime      String? // legacy / alternate finish time
  result          String? // legacy position e.g. "1st", "42nd", "DNF"

  createdAt DateTime @default(now())

  @@unique([eventId, bibNumber])
  @@index([eventId])
  @@index([organiserId])
  @@index([startWaveId])
  @@index([stripePaymentIntentId])
  @@map("registrations")
}

enum RegistrationStatus {
  CONFIRMED
  // Athlete has asked for a refund. They drop out of wave assignment and no
  // longer count against capacity; an admin processes the actual Stripe refund.
  REFUND_REQUESTED
  REFUNDED
  CANCELLED
}

// ─── User → Organiser follows ─────────────────────────────────────────────────
model OrganiserFollow {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  organiserId String
  organiser   Organiser @relation(fields: [organiserId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([userId, organiserId])
  @@index([organiserId])
  @@map("organiser_follows")
}

// ─── User → Event saves ───────────────────────────────────────────────────────
model SavedEvent {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, eventId])
  @@index([userId])
  @@map("saved_events")
}

// ─── User accounts ────────────────────────────────────────────────────────────
// Every platform user has a User record. Access to an Organiser is granted via
// OrganiserMember (a user may belong to zero or more organisers).
model User {
  id            String   @id @default(uuid())
  cognitoSub    String?  @unique
  email         String   @unique
  name          String? // full name — private; used to prefill registrations
  username      String?  @unique // public handle, chosen during profile setup
  bio           String?
  profilePicUrl String?
  coverImageUrl String?
  coverPosition String?  @default("50% 50%")
  isPublic      Boolean  @default(true) // public profile visible to others
  isBanned      Boolean  @default(false)
  mfaEnabled    Boolean  @default(false)
  recoveryCodes String?
  // Private registration prefill — never exposed on public profiles
  mobile                String?
  dateOfBirth           String? // ISO yyyy-mm-dd
  gender                String?
  emergencyContactName  String?
  emergencyContactPhone String?
  city          String? // for map centering on login
  state         String? // for map centering on login
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memberships       OrganiserMember[]
  createdOrganisers Organiser[]       @relation("OrganiserCreatedBy")
  registrations     Registration[]
  follows           OrganiserFollow[]
  savedEvents       SavedEvent[]
  reviews           Review[]
  notifications     UserNotification[]

  @@map("users")
}

// ─── Athlete notifications ────────────────────────────────────────────────────
// Delivered to signed-in athletes (e.g. when an organiser publishes wave changes).
model UserNotification {
  id        String               @id @default(uuid())
  userId    String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      UserNotificationType
  title     String
  body      String
  eventId   String?
  read      Boolean              @default(false)
  createdAt DateTime             @default(now())

  @@index([userId])
  @@map("user_notifications")
}

enum UserNotificationType {
  WAVE_UPDATE
  ORGANISER_EVENT_LIVE
  ORGANISER_REFUND_REQUEST
}

model WaitlistSubscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  @@map("waitlist_subscribers")
}

model GuestEmailVerification {
  id         String    @id @default(uuid())
  email      String
  eventId    String
  codeHash   String
  expiresAt  DateTime
  verifiedAt DateTime?
  attempts   Int       @default(0)
  lastSentAt DateTime  @default(now())
  createdAt  DateTime  @default(now())

  @@index([email, eventId])
  @@map("guest_email_verifications")
}
