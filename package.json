{
  "name": "startingline",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.11.0",
  "scripts": {
    "dev": "cross-env NODE_ENV=development next dev",
    "build": "cross-env NODE_ENV=production next build",
    "start": "cross-env NODE_ENV=production next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:seed": "npx tsx prisma/seed.ts",
    "stripe:listen": "stripe listen --forward-to localhost:3000/api/stripe/webhook",
    "stripe:setup": "node scripts/setup-stripe-local.mjs",
    "stripe:validate": "node scripts/validate-stripe-connect.mjs",
    "stripe:lifecycle": "node scripts/validate-stripe-lifecycle.mjs",
    "test:registration": "node scripts/test-registration-payment.mjs",
    "staging:db:start": "aws rds start-db-instance --db-instance-identifier startline-staging-postgres"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1073.0",
    "@aws-sdk/client-geo-places": "^3.1079.0",
    "@aws-sdk/client-s3": "^3.1041.0",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.4.2",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@radix-ui/react-checkbox": "^1.3.7",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.10",
    "@react-pdf/renderer": "^4.5.1",
    "@stripe/react-stripe-js": "^6.6.0",
    "@stripe/stripe-js": "^9.8.0",
    "animejs": "^4.5.0",
    "aws-amplify": "^6.16.4",
    "bad-words": "^4.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "exceljs": "^4.4.0",
    "jose": "^6.2.2",
    "lucide-react": "^0.469.0",
    "mapbox-gl": "^3.25.0",
    "next": "^15.5.23",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-map-gl": "^8.1.1",
    "recharts": "^3.10.1",
    "resend": "^6.9.4",
    "stripe": "^22.2.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.4.3"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@argos-ci/cli": "^6.3.0",
    "@argos-ci/playwright": "^7.3.6",
    "@playwright/test": "^1.60.0",
    "@stripe/cli": "^1.43.2",
    "@types/bad-words": "^3.0.3",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.10",
    "postcss": "^8.5.26",
    "prisma": "^7.9.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0",
    "vitest": "^3.2.7"
  }
}
